SERVER_URL=http://192.168.5.3:8000
AGENT_TOKEN=maa-demo-token
AGENT_ID=tronlong-rk3576-01
AGENT_NAME=创龙 RK3576 测试终端
AGENT_OS=linux
AGENT_ADVERTISE_URL=http://192.168.5.21:8765
ADB_SERIAL=c57bb86b
AGENT_WORKDIR=/run/media/mmcblk1p8/maa-test-terminal/data
POLL_INTERVAL_SECONDS=0.2
COMMAND_WAIT_SECONDS=15
HEARTBEAT_INTERVAL_SECONDS=10
RECORDING_TIME_LIMIT_SECONDS=180
AGENT_BIND_HOST=0.0.0.0
AGENT_PORT=8765
AGENT_INTERACTIVE_HOST=0.0.0.0
AGENT_INTERACTIVE_PORT=8766
AGENT_INTERACTIVE_PUBLIC_URL=ws://192.168.5.21:8766
INTERACTIVE_IDLE_TIMEOUT_SECONDS=1200
ADB_SERVER_HOST=127.0.0.1
ADB_SERVER_PORT=5037
MAA_ADB_PATH=/usr/bin/adb
# Prefer adb exec-out screencap -p on this physical phone; runtime falls back to 1 and 4.
MAA_ADB_SCREENCAP_METHODS=2
# Physical Android: MaaTouch | MinitouchAndAdbKey | AdbShell. Excludes emulator-only bit 8.
MAA_ADB_INPUT_METHODS=7
# raw keeps existing editor crops compatible; switch to 720p after the editor migration.
MAA_SCREENSHOT_MODE=raw
MAA_SCREENSHOT_SHORT_SIDE=720
MAA_OCR_MODEL_DIR=/run/media/mmcblk1p8/maa-test-terminal/data/maa/resource/model/ocr
MAA_YOLO_PROVIDER=agent.rknn_yolo:RknnYoloProvider
MAA_YOLO_MODEL=/run/media/mmcblk1p8/workspace/yolov8/yolov8n_640x640_rk3576.rknn
MAA_YOLO_INPUT_SIZE=640x640
MAA_RKNN_RUNTIME_VERSION=2.3.2
# Optional custom model labels file, one class name per line. Empty means COCO labels.
MAA_YOLO_LABELS=
