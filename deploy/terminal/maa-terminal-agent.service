[Unit]
Description=MAA Android Test Terminal Agent
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/run/media/mmcblk1p8

[Service]
Type=simple
User=root
WorkingDirectory=/run/media/mmcblk1p8/maa-test-terminal
EnvironmentFile=/run/media/mmcblk1p8/maa-test-terminal/.env.agent
ExecStart=/run/media/mmcblk1p8/maa-test-terminal/.venv/bin/python -m agent
Restart=always
RestartSec=3
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
